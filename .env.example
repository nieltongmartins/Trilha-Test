# Caminhos locais (opcionais)
AUDIT_DATABASE_PATH=data/database/auditoria.db
AUDIT_LOG_PATH=logs/auditoria.log
AUDIT_LOG_LEVEL=INFO

# Compatibilidade/implantação administrada. Na execução normal, estes dois valores
# podem ser salvos pela interface no perfil local do usuário.
# Somente localização/escopos; autenticação é sempre manual no Edge.
SHAREPOINT_SITE_URL=https://tenant.sharepoint.com/sites/exemplo
SHAREPOINT_SCOPE_PATHS=/sites/exemplo/Documentos Compartilhados
