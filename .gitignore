__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env

# Planilhas criadas programaticamente pelos testes (use `git add -f` se uma
# fixture binária excepcional precisar ser versionada de forma intencional).
/tests/**/*.xlsx

data/database/*.db
data/database/*.db-*
data/temp/*
data/reports/*
logs/*

!data/database/.gitkeep
!data/temp/.gitkeep
!data/reports/.gitkeep
!logs/.gitkeep
